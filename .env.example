# Supabase Cloud Configuration (Required)
# Retrieve from https://supabase.com/dashboard/project/<your-ref>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Microsoft Graph API for Excel Online Sync (Optional)
# If left blank, instant .xlsx and .csv downloads and browser spreadsheet sync are active
VITE_MS_TENANT_ID=
VITE_MS_CLIENT_ID=
